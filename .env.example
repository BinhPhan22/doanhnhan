# Sao chép thành .env rồi điền giá trị thật. KHÔNG đưa .env lên git.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=thay-bang-chuoi-ngau-nhien-dai-50-ky-tu
DJANGO_ALLOWED_HOSTS=doanhnhan.wiki,www.doanhnhan.wiki
DJANGO_CSRF_TRUSTED_ORIGINS=https://doanhnhan.wiki,https://www.doanhnhan.wiki
SITE_URL=https://doanhnhan.wiki
# Bảo mật HTTPS & HSTS (Khuyên dùng khi chạy production có SSL/HTTPS)
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1

POSTGRES_PASSWORD=dat-mat-khau-manh
# DATABASE_URL do docker-compose tự tạo; chạy ngoài Docker thì đặt:
# DATABASE_URL=postgres://doanhnhan:matkhau@localhost:5432/doanhnhan

# Email (SMTP) — để gửi thông báo duyệt, đặt lại mật khẩu
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=doanhnhan.wiki <no-reply@doanhnhan.wiki>
# Email ban biên tập nhận thông báo bản gửi mới (nhiều email cách nhau dấu phẩy)
EDITORIAL_NOTIFY_EMAILS=bientap@doanhnhan.wiki

# Đăng nhập bằng Google (tùy chọn). Để trống = ẩn nút Google.
# Redirect URI cần khai báo trên Google Cloud: https://doanhnhan.wiki/dang-nhap/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Video: lấy tiêu đề/ảnh bìa qua oEmbed (YouTube, Vimeo, TikTok)
VIDEO_FETCH_METADATA=1
MAX_IMAGE_MB=5
LOG_LEVEL=INFO
API_RATE_LIMIT_PER_MIN=120

# Trí tuệ nhân tạo (Google Gemini API) — Trợ lý viết bài cho Ban biên tập
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

